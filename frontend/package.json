{
  "name": "lychee-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:mock": "VITE_USE_MOCKS=true vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "api:gen": "openapi-typescript ../backend/openapi.json -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "lucide-vue-next": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.4",
    "plyr": "^3.8.4",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "daisyui": "^5.6.16",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.4"
  },
  "packageManager": "bun@1.3.14",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}