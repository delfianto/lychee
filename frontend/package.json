{
  "name": "lychee-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:mock": "VITE_USE_MOCKS=true vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "api:gen": "openapi-typescript ../backend/openapi.json -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "lucide-vue-next": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "plyr": "^3.8.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "daisyui": "^5.7.46",
    "happy-dom": "^20.14.5",
    "msw": "^3.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "bun@1.3.14",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
