{
  "name": "lychee-frontend",
  "version": "0.1.0-beta.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "dev:mock": "VITE_USE_MOCKS=true vp dev --host",
    "build": "vue-tsc --noEmit && vp build",
    "preview": "vp preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "api:gen": "openapi-typescript ../backend/openapi.json -o ./src/api/schema.d.ts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "check": "vp check && bun run typecheck",
    "descriptions:audit": "bun scripts/audit-descriptions.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "flag-icons": "^7.6.0",
    "markdown-it": "^15.0.3",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "plyr": "^3.8.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "daisyui": "^5.7.50",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
