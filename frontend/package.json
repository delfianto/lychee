{
  "name": "lychee-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "api:gen": "openapi-typescript ../backend/openapi.json -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "pinia": "^3.0.4",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-vue": "^6.0.7",
    "daisyui": "^5.6.16",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.4"
  },
  "packageManager": "bun@1.3.14"
}
