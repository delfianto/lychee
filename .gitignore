# lychee is a monorepo. Python-specific ignores live in backend/.gitignore and
# Node/Vite ignores in frontend/.gitignore — this root file only covers
# cross-cutting cruft and repo-root artifacts.

# OS / editor (can appear in any directory)
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# SuperDesign local scratch (design drafts live in the cloud, not the repo)
.superdesign/

# Server media/library storage (configurable; default ./storage at the repo root)
/storage/
/backend/storage/

# Cloned reference projects for research (see notes/) — reference only, not vendored
/temp/

# Claude Code — shared config (settings.json, hooks/, skills/) is tracked;
# ignore only the per-machine local overrides
.claude/settings.local.json
