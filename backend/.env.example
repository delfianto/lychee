# Deployment environment: development (default) | production
ENVIRONMENT=development

# Database — SQLite by default (see ../notes/decisions/04-database-sqlite.md).
# Relative (three slashes):  sqlite:///./lychee.db
# Absolute (four slashes):   sqlite:////var/lib/lychee/lychee.db
DATABASE_URL=sqlite:///./lychee.db
# Optional local Turso/MVCC (no cloud): sqlite+turso:////var/lib/lychee/lychee-turso.db
# Convert into a NEW file first: just db-to-turso SOURCE DESTINATION
# See ../notes/decisions/23-local-turso.md; do not open a live SQLite file with Turso.

# Storage root for generated files (thumbnails, etc.). Relative → resolved under backend/.
STORAGE_PATH=./storage

# Secret key — passphrase used to encrypt stored provider/tracker secrets at rest
# (MangaDex / AniList / MyAnimeList / MangaUpdates tokens). Leave unset to run without
# connecting any accounts; connecting one is refused unless this is set (no plaintext
# secrets on disk). Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LYCHEE_SECRET_KEY=

# Initial default for both conversion and thumbnail worker limits (1 = in-process).
# Settings → Libraries → Image processing saves independent limits (1–64), which
# override this default and apply without restart. Each AVIF job uses one native
# encoder thread; separate process pools handle conversions and thumbnails.
LYCHEE_ENCODE_WORKERS=1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# Logging — DEBUG is the dev-friendly default (matches ENVIRONMENT=development above);
# set LOG_LEVEL=INFO for production.
LOG_LEVEL=DEBUG
LOG_FORMAT=console
